{
  "extends": "next/core-web-vitals",
  "ignorePatterns": [".next/", "out/", "build/", "node_modules/", "AI/", "public/"],
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": [
      "warn",
      { "args": "none", "ignoreRestSiblings": true, "varsIgnorePattern": "^_" }
    ]
  }
}
